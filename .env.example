# ---- Apollo (b2b lane only) ----
APOLLO_API_KEY=

# ---- Claude ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_MODEL_STRONG=claude-sonnet-5

# ---- Sending mailbox (Gmail / Workspace App Password, NOT account password) ----
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
FROM_NAME=Baseleaf
REPLY_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# ---- Sending guardrails ----
DAILY_SEND_CAP=25
SEND_DELAY_MIN_SECONDS=60
SEND_DELAY_MAX_SECONDS=180

# ---- Compliance (CAN-SPAM: both required on every email) ----
COMPANY_NAME=Baseleaf
PHYSICAL_ADDRESS=
UNSUBSCRIBE_BASE_URL=https://baseleaf.com/unsubscribe
UNSUBSCRIBE_SECRET=
FREE_TOOL_URL=https://baseleaf.com/eligibility-check

# ---- Optional ----
SLACK_WEBHOOK_URL=
